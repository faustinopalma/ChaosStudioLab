#!/bin/sh
set -eu

ttl="${1:-}"
reason="${2:-}"

case "$ttl" in
    ''|*[!0-9]*) echo "TTL must be an integer from 1 to 300 seconds." >&2; exit 2 ;;
esac
if [ "$ttl" -lt 1 ] || [ "$ttl" -gt 300 ]; then
    echo "TTL must be an integer from 1 to 300 seconds." >&2
    exit 2
fi
case "$reason" in
    ''|*[!A-Za-z0-9._-]*) echo "Reason must use 1-80 letters, digits, dot, underscore, or hyphen." >&2; exit 2 ;;
esac
if [ "${#reason}" -gt 80 ]; then
    echo "Reason must use 1-80 letters, digits, dot, underscore, or hyphen." >&2
    exit 2
fi

expires_at="$(date -u -d "+${ttl} seconds" '+%Y-%m-%dT%H:%M:%SZ')"
temporary_file="/tmp/csl-readiness-fault.json.tmp"
fault_file="${Chaos__ReadinessFaultPath:-/tmp/csl-readiness-fault.json}"
printf '{"expiresAtUtc":"%s","reason":"%s"}\n' "$expires_at" "$reason" > "$temporary_file"
mv "$temporary_file" "$fault_file"

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Windows App Service waits for this request before routing traffic to a restarted or new instance. -->
    <applicationInitialization doAppInitAfterRestart="true">
      <add initializationPage="/health/ready" />
    </applicationInitialization>
  </system.webServer>
</configuration>

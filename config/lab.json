{
  "labId": "lab-dev01",
  "projectDefaultRegion": "italynorth",
  "deploymentRegion": "swedencentral",
  "resourceGroupPrefixes": {
    "network": "rg-csl-net",
    "workload": "rg-csl-work",
    "operations": "rg-csl-ops"
  },
  "network": {
    "workloadAddressPrefix": "10.81.0.0/16",
    "operationsAddressPrefix": "10.82.0.0/16",
    "appServiceIntegrationSubnetPrefix": "10.81.0.0/24",
    "privateEndpointsSubnetPrefix": "10.81.10.0/24",
    "operationsSubnetPrefix": "10.82.1.0/24",
    "operationsBastionSubnetPrefix": "10.82.2.0/26"
  },
  "workload": {
    "applicationPlatform": "LinuxAppService",
    "appServiceSku": "P1v3",
    "appServiceWorkers": 6,
    "requiredPhysicalZones": 3,
    "linuxFxVersion": "DOTNETCORE|10.0",
    "postgresqlSku": "Standard_D4ds_v5",
    "postgresqlStorageGiB": 128,
    "postgresqlHighAvailabilityMode": "ZoneRedundant",
    "availabilityZones": [
      "1",
      "2",
      "3"
    ]
  },
  "test": {
    "targetOperationsPerSecond": 20,
    "readPercentage": 80,
    "writePercentage": 20,
    "warmupMinutes": 5,
    "baselineMinutes": 10,
    "processCrashObservationMinutes": 5,
    "recoveryObservationMinutes": 10,
    "databaseRecoveryObjectiveSeconds": 180
  },
  "lifecycle": {
    "manualDeletionOnly": true,
    "automaticFaultExecution": false,
    "localStateRoot": "../.local"
  },
  "tags": {
    "project": "ChaosStudioLab",
    "labId": "lab-dev01",
    "environment": "nonproduction",
    "owner": "lab-operator"
